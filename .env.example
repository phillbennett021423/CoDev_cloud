# Copy this file to .env (same folder as server.js) and fill in your own values,
# or run "npm run setup", which copies it for you. .env is gitignored, so your
# keys never get committed. Don't put keys in server.js. All keys are optional:
# without them CoDev uses the keys you enter in Settings.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENROUTER_API_KEY=sk-or-your-key-here
# Optional: your Manus API key for Q tasks (manus.im > Settings > API).
# MANUS_API_KEY=your-manus-key-here
# Optional: a free The Odds API key (the-odds-api.com, 500 credits a month) for market odds in the Outlier tab.
# ODDS_API_KEY=your-odds-api-key-here
# Optional: Google apps for agents (docs/google-apps.md). A Google API key turns on
# full YouTube and Google Maps; an OAuth "Desktop app" client turns on Gmail.
# (Cloud files use MEGA instead of Google Drive: sign in under Settings > MEGA cloud,
# docs/mega-cloud.md. No key is needed.)
# These can also be entered in CoDev's Settings > Google apps instead.
# GOOGLE_API_KEY=AIza-your-key-here
# GOOGLE_CLIENT_ID=1234-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-your-secret-here
# The project folder agents work in (start-codev.bat C:\path\to\project sets it too).
# CODEV_WORKSPACE=C:\path\to\project
# Where agent sandboxes, staged changes and browser profiles go. Default: .codev here.
# CODEV_DATA_DIR=
# Agents' browsers keep their sign-ins (cookies, local storage) between runs. 0 = temporary profiles.
# CODEV_BROWSER_KEEP_SIGNINS=1
# Passphrase for the browser tools' saved logins. Default: protected by Windows.
# CODEV_VAULT_KEY=
# The Godot 4 and Blender programs for the game tools, if CoDev doesn't find them itself.
# CODEV_GODOT_PATH=C:\Godot\Godot_v4.3-stable_win64.exe
# CODEV_BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 4.2\blender.exe
# The art pipeline (art_* tools). All free and on this computer; each is optional.
# ComfyUI for concepts, edits, try-on, sketches and outpainting (default http://127.0.0.1:8188):
# CODEV_COMFYUI_URL=http://127.0.0.1:8188
# The ComfyUI folder, so trained LoRAs are copied into models/loras:
# CODEV_COMFYUI_DIR=C:\ComfyUI
# LoRA trainers: kohya sd-scripts (SDXL/SD 1.5) and ostris ai-toolkit (FLUX, edit LoRAs):
# CODEV_KOHYA_DIR=C:\sd-scripts
# CODEV_AITOOLKIT_DIR=C:\ai-toolkit
# Real-ESRGAN ncnn (upscaling), Piper (voice lines) and its voices folder, FFmpeg, Coqui TTS:
# CODEV_REALESRGAN_PATH=C:\realesrgan\realesrgan-ncnn-vulkan.exe
# CODEV_PIPER_PATH=C:\piper\piper.exe
# CODEV_PIPER_VOICES=C:\piper\voices
# CODEV_FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# CODEV_TTS_PATH=
# Python 3 with numpy and Pillow (pip install numpy pillow rembg) for PBR maps, weathering, cutouts:
# CODEV_PYTHON=python
# PORT=3000
