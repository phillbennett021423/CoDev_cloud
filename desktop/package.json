{
  "name": "codev-studio-desktop",
  "productName": "CoDev Studio",
  "version": "1.0.0",
  "description": "CoDev Studio desktop app for Windows",
  "main": "main.js",
  "private": true,
  "scripts": {
    "copy-www": "node -e \"const fs=require('fs');fs.rmSync('www',{recursive:true,force:true});fs.cpSync('../mobile/www','www',{recursive:true})\"",
    "start": "npm run copy-www && electron .",
    "dist": "npm run copy-www && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "com.codev.studio",
    "productName": "CoDev Studio",
    "artifactName": "CoDev-Studio-Setup.${ext}",
    "files": ["main.js", "preload.js", "mcp-tools.js", "www/**/*"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": { "icon": "build/icon.png", "target": "nsis" },
    "nsis": { "oneClick": true, "perMachine": false, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "CoDev Studio" }
  }
}
