{
  "name": "codev-cloud",
  "version": "1.0.0",
  "description": "Serves CoDev Studio locally at http://localhost:3000",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "setup": "node scripts/setup.js",
    "check": "node scripts/setup.js --check",
    "test:agents": "node --test \"tests/*.test.js\"",
    "test:outlier": "python -m unittest discover tools/outlier-analytics"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "playwright-core": "1.64.1"
  }
}
